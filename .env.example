# ---- Local single-user mode (node src/server/node.ts) ----
PORT=8787
DATABASE_PATH=./data/investinews.sqlite        # SQLite file; migrations apply automatically on start
APP_TZ=Africa/Johannesburg
POLL_INTERVAL_SEC=300                          # background scheduler cadence in local mode
RETENTION_DAYS=90

# Required by SEC fair-access policy: identify your app and a contact address.
SEC_USER_AGENT="investinews personal news terminal you@example.com"

# Optional auth. When APP_TOKEN is set every /api call needs it (Bearer header or login cookie).
# REQUIRED for any deployment reachable from the internet.
APP_TOKEN=
# Token that external cron / the cron worker sends to POST /api/jobs/poll (X-Job-Token header).
JOB_TOKEN=

# Web Push (generate with: npm run vapid). Never expose the private key to the client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
